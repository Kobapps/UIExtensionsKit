# This repository is a Unity *project* that embeds the package under
# Packages/com.kobapps.uiextensionskit. The project exists to develop and test the package; only
# the package folder plus ProjectSettings/ and Packages/manifest.json are worth versioning.

# Unity project artifacts
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# Generated by the showcase sample; rebuild it from the Tools menu instead of committing it
/Assets/UIExtensionsKit Showcase/

# Samples imported through the Package Manager. The originals live in the package's Samples~
# folder; a copy under Assets/ is a build artifact that goes stale the moment the source changes.
/Assets/Samples/

# Never commit generated project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE / OS
.vs/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Claude Code tooling config and the Unity-MCP generated skill docs. Local to this machine,
# not part of the package.
/.claude/

# The Unity MCP plugin's imported assets. A development aid for this project, not something
# consumers of the package should inherit.
/Assets/Plugins/
/Assets/Plugins.meta

# Assets created while testing the preset/style generators.
/Assets/ButtonAnimationPresetPreset.asset
/Assets/ButtonAnimationPresetPreset.asset.meta
/Assets/EnhancedButtonStyle.asset
/Assets/EnhancedButtonStyle.asset.meta

# Orphan meta for the Package-Manager sample import folder, which is itself ignored.
/Assets/Samples.meta
